    "lint": "pnpm -r lint",
    "migrate": "node packages/orm/migrate.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
