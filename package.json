{
  "name": "flam2-orm-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Lightweight TypeScript ORM monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "typecheck": "pnpm -r typecheck",
