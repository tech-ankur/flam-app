{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch --env-file=.env src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "vite build",
    "build": "pnpm build:server && pnpm build:client",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@flam2/orm": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "tsx": "^4.18.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
